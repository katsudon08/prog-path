{
  "compilerOptions": {
    // Vite の build.target (既定: chrome107 / edge107 /
    // firefox104 / safari16) で使える上限に合わせている。
    // ES2023 以降の機能は Safari 16.4+ が必要になる
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    // エイリアスはこの1つだけ。旧コードも src/legacy へ移して
    // @/legacy/... で参照するため、2つ目の入口を作らずに済む
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "out", "dist", "build"]
}
