{
  "name": "prog-path",
  "version": "1.0.1",
  "main": "main.js",
  "private": true,
  "description": "A programming education app for elementary school students. Use cards to control a robot and navigate through mazes.",
  "author": "katsudon08",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.34.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "commitlint": "commitlint --edit",
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown",
    "format:check": "prettier --check --ignore-unknown",
    "lint": "eslint --max-warnings=0 --no-warn-ignored",
    "lint:fix": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "check": "pnpm run --silent format:check . && pnpm run --silent lint .",
    "electron:dev": "concurrently -k \"pnpm dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "pnpm build && electron-builder"
  },
  "build": {
    "appId": "app.prog-path.vercel",
    "productName": "prog-path",
    "files": [
      "out/**/*",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@tanstack/react-router": "^1.170.32",
    "@types/three": "^0.180.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.454.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "4.1.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "wait-on": "^9.0.3"
  }
}
