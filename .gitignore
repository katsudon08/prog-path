# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# build output (Vite+ / vp)
/dist
/dist-ssr
*.local

# Tauri
/src-tauri/target
/src-tauri/gen

# testing / coverage
/coverage

# TypeScript
*.tsbuildinfo

# mise (local overrides)
.mise.local.toml

# logs
*-debug.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# npm config
.npmrc

# prompts / scratch
repomix-output.xml
commit_message.txt

# AI discussion scratch space
# docs/ai の議論・調査・計画メモは Git 管理しない（運用ルールは docs/ai/README.md）。
# 運用ルールを書いた README だけは例外で追跡する（ディレクトリ自体ではなく中身を ignore し、! で再追跡）。
docs/ai/**
!docs/ai/README.md

# spike の vendoring（使い捨て検証用に取得した外部 UMD ビルド）は追跡しない。
# 取得手順は各 spike の README に curl コマンドとして残す（再現可能）。
spikes/**/vendor/
