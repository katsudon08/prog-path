# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# build output (Vite+ / vp)
/dist
/dist-ssr
*.local

# Tauri
/src-tauri/target
/src-tauri/gen

# testing / coverage
/coverage

# TypeScript
*.tsbuildinfo

# mise (local overrides)
.mise.local.toml

# logs
*-debug.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# npm config
.npmrc

# prompts / scratch
repomix-output.xml
commit_message.txt

# AI 作業場（個人的な議論・調査メモ）。メモ本体は Git 管理しないが、運用ルールを書いた README だけは追跡する。
# 注: ディレクトリ自体を ignore (/docs/ai/) すると配下の例外(!)が効かないため、中身(*)を ignore する。
/docs/ai/*
!/docs/ai/README.md
