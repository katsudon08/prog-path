# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# build output (Vite+ / vp)
/dist
/dist-ssr
*.local

# Tauri
/src-tauri/target
/src-tauri/gen

# testing / coverage
/coverage

# Storybook build output / エラー時のデバッグログ
/storybook-static
debug-storybook.log

# TypeScript
*.tsbuildinfo

# mise (local overrides)
.mise.local.toml

# logs
*-debug.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# npm config
.npmrc

# prompts / scratch
repomix-output.xml
commit_message.txt

# spike の vendoring（使い捨て検証用に取得した外部 UMD ビルド）は追跡しない。
# 取得手順は各 spike の README に curl コマンドとして残す（再現可能）。
spikes/**/vendor/
